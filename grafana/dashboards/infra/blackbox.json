      "options": {
        "mode": "markdown",
        "content": "**blackbox-exporter**: ping ICMP a hosts sin agente propio (NAS, Proxmox, `luffy`, router ASUS, site B) y HTTP a cada servicio publicado (`*.bonchan.org`). Los servicios tras Authentik pueden dar 2xx por la página de login, no por la app en sí -- ver comentario en `services/monitor/blackbox-exporter/probes-http.yaml`."
      },
      "transparent": false
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "color-background",
              "mode": "basic"
            },
            "inspect": false
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
