# Gestionado por Ansible (rol home-services). No editar a mano.
services:
  pihole:
    container_name: pihole
    image: pihole/pihole:latest
    ports:
      - "53:53/tcp"
      - "53:53/udp"
      - "8080:80/tcp"
    environment:
      TZ: "{{ home_services_timezone }}"
      WEBPASSWORD: "{{ pihole_web_password }}"
      PIHOLE_DNS_: "{{ pihole_dns_upstream }}"
    volumes:
      - "./pihole:/etc/pihole"
      - "./dnsmasq.d:/etc/dnsmasq.d"
    restart: unless-stopped
    network_mode: host

  homeassistant:
    container_name: homeassistant
    image: "ghcr.io/home-assistant/home-assistant:stable"
    volumes:
      - "./homeassistant:/config"
      - "/etc/localtime:/etc/localtime:ro"
    devices:
      - "/dev/ttyUSB0:/dev/ttyUSB0:rwm"
    restart: unless-stopped
    network_mode: host

  piper:
    container_name: piper
    image: "rhasspy/wyoming-piper:latest"
    command: --voice {{ piper_voice }}
    volumes:
      - "./piper:/data"
    ports:
      - "10200:10200"
    restart: unless-stopped

  node-exporter:
    container_name: node-exporter
    image: "prom/node-exporter:v1.12.1"
    command:
      - "--path.procfs=/host/proc"
      - "--path.sysfs=/host/sys"
      - "--path.rootfs=/host"
      - "--collector.filesystem.mount-points-exclude=^/(sys|proc|dev|host|etc)($$|/)"
    volumes:
      - "/proc:/host/proc:ro"
      - "/sys:/host/sys:ro"
      - "/:/host:ro,rslave"
    restart: unless-stopped
    network_mode: host
    pid: host

  pihole-exporter:
    container_name: pihole-exporter
    image: "ekofr/pihole-exporter:v1.2.0"
    environment:
      PIHOLE_HOSTNAME: "127.0.0.1"
      PIHOLE_PASSWORD: "{{ pihole_web_password }}"
      PORT: "9617"
    restart: unless-stopped
    network_mode: host
